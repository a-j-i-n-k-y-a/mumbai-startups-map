# Optional: geocoding provider key used by the scraper (scripts/).
# Nominatim needs no key but requires a descriptive User-Agent.
GEOCODER_USER_AGENT="mumbai-startups-map (your-email@example.com)"

# Optional: swap the basemap. Leave unset to use OpenStreetMap tiles.
NEXT_PUBLIC_TILE_URL=
NEXT_PUBLIC_TILE_ATTRIBUTION=
